{
  "$schema": "https://opencode.ai/config.json",

  // Default model for interactive sessions (no agent selected).
  // Each agent explicitly declares its own model — see agents/*.md.
  "model": "glm-5.2:cloud",

  // Global permission defaults — agents override where they need stricter or looser access.
  // Global operating rules live in ~/.config/opencode/AGENTS.md — opencode auto-loads it.
  // Agents are defined as markdown files in ~/.config/opencode/agents/*.md
  "permission": {
    "edit": "ask",
    "bash": "ask",
    "webfetch": "allow"
  }
}
